{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    "apps/desktop/src/renderer/**/*.ts",
    "apps/desktop/src/renderer/**/*.tsx",
    "apps/desktop/src/renderer/**/*.d.ts",
